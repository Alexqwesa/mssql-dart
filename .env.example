MSSQL_ENCRYPT=0
MSSQL_TRUST_SERVER_CERTIFICATE=1
# Set to 1 only when running against docker-compose.live.force-tls.yml
# (forceencryption=1). Enables test/live/tls_force_encrypt_stress_test.dart.
# MSSQL_FORCE_ENCRYPTION=0
