+/// Coordinates explicit plaintext fragments with the secure socket filter.
+///
+/// Keeping this state outside [_RawSecureSocket] leaves the ordinary TLS path
+/// with one nullable helper field and short-circuited integration hooks. The
+/// helper is created only when [RawSecureSocket.writeTlsFragment] is used.
+final class _TlsFragmentWriter {
+  final _RawSecureSocket _socket;
+  bool _boundaryPending = false;
+  List<Completer<void>>? _drainWaiters;
+
+  _TlsFragmentWriter(this._socket);
+
+  static int maximumLength(_RawSecureSocket socket) {
+    final buffers = socket._secureFilter?.buffers;
+    if (buffers == null) throw const SocketException.closed();
+    // A circular buffer with coincident start/end cursors needs one sentinel
+    // byte to distinguish an empty ring from a full ring.
+    return buffers[_RawSecureSocket.writePlaintextId].size - 1;
+  }
+
+  Future<void> write(List<int> data) async {
+    _ensureWritable();
+    if (isActive) {
+      throw StateError('A TLS fragment write is already active');
+    }
+
+    final limit = maximumLength(_socket);
+    final checkedLength = data.length;
+    if (checkedLength > limit) {
+      throw ArgumentError.value(
+        checkedLength,
+        'data',
+        'TLS fragment exceeds the $limit-byte plaintext limit',
+      );
+    }
+
+    // Claim the next quiescent write boundary before awaiting it. Once reached,
+    // _RawSecureSocket._tryFilter pauses so no native filter call can race the
+    // cursor rebase.
+    _boundaryPending = true;
+    try {
+      // Establish the leading fragment boundary. This drains both plaintext
+      // waiting for SSL_write() and ciphertext waiting for RawSocket.write().
+      await _waitForDrain();
+      _ensureWritable();
+
+      // A length change is cheap to detect and must fail before any bytes enter
+      // the ring. Detecting element changes would require an additional O(n)
+      // snapshot and allocation for every low-level fragment. Callers retain
+      // responsibility for content immutability; higher-level APIs can copy.
+      if (data.length != checkedLength) {
+        throw StateError('TLS fragment length changed while waiting to write');
+      }
+
+      final buffer =
+          _socket._secureFilter!.buffers![_RawSecureSocket.writePlaintextId];
+      // Empty-ring cursor positions carry no data. Rebasing them to zero makes
+      // every usable byte one physical range, so one native SSL_write() is
+      // sufficient without allocating a scratch buffer.
+      buffer.rebaseEmpty();
+      if (checkedLength != 0) {
+        final written = buffer.write(data, 0, checkedLength);
+        if (written != checkedLength) {
+          throw StateError('TLS plaintext buffer was not empty after draining');
+        }
+        _socket._filterStatus.writeEmpty = false;
+        await _socket._scheduleFilter();
+        await _waitForDrain();
+      }
+    } finally {
+      _boundaryPending = false;
+      // A paused filter may still have inbound TLS work or socket events to
+      // process after fragment ownership is released.
+      _socket._scheduleFilter();
+    }
+  }
+
+  bool get isActive => _boundaryPending;
+
+  bool get shouldPauseFilter => _boundaryPending && _isWriteDrained;
+
+  void afterFilterPass() => _completeDrainWaiters();
+
+  void fail(Object error, [StackTrace? stackTrace]) {
+    final waiters = _drainWaiters;
+    if (waiters == null) return;
+    _drainWaiters = null;
+    for (final waiter in waiters) {
+      waiter.completeError(error, stackTrace);
+    }
+  }
+
+  void _ensureWritable() {
+    if (_socket._status != _RawSecureSocket.connectedStatus ||
+        _socket._closedWrite ||
+        _socket._socketClosedWrite ||
+        _socket._secureFilter == null) {
+      throw const SocketException.closed();
+    }
+  }
+
+  bool get _isWriteDrained {
+    final buffers = _socket._secureFilter?.buffers;
+    return _socket._status == _RawSecureSocket.connectedStatus &&
+        !_socket._filterActive &&
+        _socket._filterStatus.writeEmpty &&
+        buffers != null &&
+        buffers[_RawSecureSocket.writePlaintextId].isEmpty &&
+        buffers[_RawSecureSocket.writeEncryptedId].isEmpty;
+  }
+
+  Future<void> _waitForDrain() {
+    if (_isWriteDrained) return Future<void>.value();
+    if (_socket._status == _RawSecureSocket.closedStatus ||
+        _socket._secureFilter == null) {
+      return Future<void>.error(const SocketException.closed());
+    }
+
+    // There is deliberately no transport-level timeout here: backpressure can
+    // legitimately keep a raw socket pending, and the SDK cannot choose an
+    // application deadline. Callers that accept untrusted peers should apply a
+    // timeout to writeTlsFragment() and close the socket when it expires.
+    final completer = Completer<void>();
+    (_drainWaiters ??= <Completer<void>>[]).add(completer);
+    _socket._scheduleFilter();
+    return completer.future;
+  }
+
+  void _completeDrainWaiters() {
+    final waiters = _drainWaiters;
+    // The list is allocated only immediately before adding its first waiter.
+    if (waiters == null || !_isWriteDrained) return;
+    // Detach this batch before completing it because a continuation can add a
+    // waiter for a later drain cycle.
+    _drainWaiters = null;
+    for (final waiter in waiters) {
+      waiter.complete();
+    }
+  }
+}
