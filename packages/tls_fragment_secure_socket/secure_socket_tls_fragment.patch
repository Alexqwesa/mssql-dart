 /// A circular buffer backed by an external byte array.  Accessed from
 /// both C++ and Dart code in an unsynchronized way, with one reading
 /// and one writing.  All updates to start and end are done by Dart code.
@@ -1338,6 +1530,19 @@ class _ExternalBuffer {
 
   bool get isEmpty => end == start;
 
+  /// Moves an empty ring to its canonical cursor position.
+  ///
+  /// No bytes are relocated: an empty ring has no live range. Starting at zero
+  /// exposes [size] - 1 contiguous bytes while preserving the sentinel byte
+  /// that distinguishes a full ring from an empty one.
+  void rebaseEmpty() {
+    if (!isEmpty) {
+      throw StateError('Cannot rebase a non-empty circular buffer');
+    }
+    start = 0;
+    end = 0;
+  }
+
   int get length => start > end ? size + end - start : end - start;
 
   int get linearLength => start > end ? size - start : end - start;
